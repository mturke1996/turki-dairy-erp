# ============================================================
# مصنع التركي للحليب ومشتقاته — متغيرات البيئة
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3100

# local = وضع محلي بدون Supabase Auth (تطوير)
# supabase = مصادقة + مزامنة سحابية (إنتاج)
NEXT_PUBLIC_DATA_SOURCE=local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# مطلوب على الخادم فقط — لإدارة المستخدمين (لا تضف NEXT_PUBLIC_ أمامه)
# من Supabase: Project Settings → API → service_role (secret) — يبدأ عادة بـ eyJ...
# على Vercel: Settings → Environment Variables → Production + Preview → ثم Redeploy
SUPABASE_SERVICE_ROLE_KEY=
